{
  "manifest_version": 3,
  "name": "Monitor",
  "description": "Monitor any value on any website. Local-first, private, no account required.",
  "version": "0.1.0",
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "96": "icon/96.png",
    "128": "icon/128.png"
  },
  "action": { "default_title": "Monitor" },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "notifications",
    "offscreen",
    "favicon"
  ],
  "optional_host_permissions": ["*://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["icon/*.png", "credit-avatar.webp"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": { "service_worker": "background.js" },
  "options_ui": { "open_in_tab": false, "page": "options.html" }
}
