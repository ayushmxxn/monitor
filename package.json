{
  "name": "monitor-ext",
  "description": "Local-first Chrome extension for monitoring any value on any website",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "bun test/safetyNet.test.ts && bun test/pipeline.test.ts && bun test/historyChart.test.ts",
    "test:safety": "bun test/safetyNet.test.ts",
    "test:chart": "bun test/historyChart.test.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "wxt": "^0.21.4"
  },
  "trustedDependencies": [
    "spawn-sync"
  ]
